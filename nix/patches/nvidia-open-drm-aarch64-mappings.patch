# From github.com/pfeifferj/archlinuxarm-proart-p16 @ 3484cc0 (MIT),
# 02-drivers/nvidia-display/patches/provenance/hardware/drm.patch: aarch64 nvidia-drm
# mappings (Normal-NC vmap of RAM-backed GEM, write-combined PRIME maps) for console and Wayland.
--- a/kernel-open/nvidia-drm/nvidia-drm-os-interface.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-os-interface.c
@@ -19,10 +19,11 @@
  * FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
  * DEALINGS IN THE SOFTWARE.
  */
 
 #include <linux/slab.h>
+#include <linux/printk.h>
 
 #include "nvidia-drm-os-interface.h"
 
 #if defined(NV_DRM_AVAILABLE)
 
@@ -148,11 +149,18 @@
 void *nv_drm_vmap(struct page **pages, unsigned long pages_count, bool cached)
 {
     pgprot_t prot = PAGE_KERNEL;
 
     if (!cached) {
+#if defined(NV_LINUX) && defined(NVCPU_AARCH64)
+        /* RAM-backed GEM mappings use the same Normal-NC type as userspace. */
+        prot = pgprot_writecombine(PAGE_KERNEL);
+        pr_info_once("nvidia-drm: P16 Normal-NC candidate RAM vmap pages=%lu prot=%#lx\n",
+                     pages_count, (unsigned long)pgprot_val(prot));
+#else
         prot = pgprot_noncached(PAGE_KERNEL);
+#endif
     }
 
     return vmap(pages, pages_count, VM_USERMAP, prot);
 }
 
--- a/kernel-open/nvidia-drm/nvidia-drm-gem-nvkms-memory.c
+++ b/kernel-open/nvidia-drm/nvidia-drm-gem-nvkms-memory.c
@@ -24,10 +24,14 @@
 
 #if defined(NV_DRM_AVAILABLE)
 
 #include "nvidia-drm-gem-nvkms-memory.h"
 #include "nvidia-drm-helper.h"
+#include "nvidia-drm-os-interface.h"
+#if defined(NV_LINUX)
+#include <linux/printk.h>
+#endif
 #include "nv_drm_common_ioctl.h"
 
 #include <drm/drm_drv.h>
 #include <drm/drm_prime.h>
 
@@ -300,14 +304,22 @@
     if (nv_nvkms_memory->physically_mapped) {
         void *address;
 
         if (nv_nvkms_memory->pWriteCombinedIORemapAddress != NULL) {
             address = nv_nvkms_memory->pWriteCombinedIORemapAddress;
+#if defined(NV_LINUX) && defined(NVCPU_AARCH64)
+            pr_info_once("nvidia-drm: P16 candidate PRIME map=non-RAM-ioremap-wc bytes=%llu\n",
+                         (unsigned long long)nv_gem->base.size);
+#endif
         }
 #if defined(NVCPU_AARCH64)
         else if (nv_nvkms_memory->pNumaVMapAddress != NULL) {
             address = nv_nvkms_memory->pNumaVMapAddress;
+#if defined(NV_LINUX)
+            pr_info_once("nvidia-drm: P16 candidate PRIME map=RAM-NUMA-vmap-NormalNC bytes=%llu\n",
+                         (unsigned long long)nv_gem->base.size);
+#endif
         }
 #endif
         else {
             return ERR_PTR(-ENOMEM);
         }
@@ -328,10 +340,14 @@
      * If this buffer isn't physically mapped, it might be backed by struct
      * pages. Use vmap in that case. Do a noncached mapping for system memory
      * as display is non io-coherent device in case of Tegra.
      */
     if (nv_nvkms_memory->pages_count > 0) {
+#if defined(NV_LINUX) && defined(NVCPU_AARCH64)
+         pr_info_once("nvidia-drm: P16 candidate PRIME map=RAM-pages-vmap-NormalNC bytes=%llu\n",
+                      (unsigned long long)nv_gem->base.size);
+#endif
          return nv_drm_vmap(nv_nvkms_memory->pages,
                             nv_nvkms_memory->pages_count,
                             false);
     }
 
@@ -342,10 +358,15 @@
     struct nv_drm_gem_object *nv_gem,
     void *address)
 {
     struct nv_drm_gem_nvkms_memory *nv_nvkms_memory =
         to_nv_nvkms_memory(nv_gem);
+
+#if defined(NV_LINUX) && defined(NVCPU_AARCH64)
+    /* Finish CPU WC stores before unmapping or releasing the GC6 blocker. */
+    nv_drm_write_combine_flush();
+#endif
 
     if (!nv_nvkms_memory->physically_mapped &&
         nv_nvkms_memory->pages_count > 0) {
         nv_drm_vunmap(address);
     }
