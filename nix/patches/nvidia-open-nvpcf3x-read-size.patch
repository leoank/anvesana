# NVPCF 3.x reads (_DSM revision 0x300, subfunctions 1-3) get the caller's whole buffer.
# 620.70.06 divides the size by 4 before evaluating _DSM, so with the 4 KiB cap the
# receive buffer is at most 1 KiB, and bbaum-pc-7's NPCF function 1 returns 2,176 bytes:
# nv_acpi_extract_buffer fails with NV_ERR_BUFFER_TOO_SMALL ("DSM data invalid") and
# nvidia-powerd quits. The same size also sizes Arg3, which the kernel interface caps at
# 1 KiB, so Arg3 is capped there separately (the firmware ignores it for reads).
diff --color -ru a/src/nvidia/arch/nvalloc/unix/src/os.c b/src/nvidia/arch/nvalloc/unix/src/os.c
--- a/src/nvidia/arch/nvalloc/unix/src/os.c	2026-11-20 12:11:36.419844147 +0000
+++ b/src/nvidia/arch/nvalloc/unix/src/os.c	2026-11-20 12:11:36.447691657 +0000
@@ -3273,7 +3273,9 @@
         case ACPI_DSM_FUNCTION_NVPCF_3X:
             pAcpiDsmGuid = (NvU8 *)&NVPCF_ACPI_DSM_GUID;
             acpiDsmRev = NVPCF_3X_ACPI_DSM_REVISION_ID;
-            acpiDsmInArgSize = (*pSize);
+            // *pSize is the output buffer's size; Arg3 is capped at the
+            // kernel interface's 1 KiB (NV_MAX_ACPI_DSM_PARAM_SIZE).
+            acpiDsmInArgSize = NV_MIN((*pSize), 1024);
             acpiNvpcfDsmFunction = NV_TRUE;
             break;
 
diff --color -ru a/src/nvidia/src/kernel/rmapi/client_resource.c b/src/nvidia/src/kernel/rmapi/client_resource.c
--- a/src/nvidia/src/kernel/rmapi/client_resource.c	2026-11-20 12:11:36.391829978 +0000
+++ b/src/nvidia/src/kernel/rmapi/client_resource.c	2026-11-20 12:11:36.447431654 +0000
@@ -3331,13 +3331,6 @@
                         goto nvpcf3xGetParams_exit;
                     }
                 }
-                else
-                {
-                    // Divide by 4 for cases of sub-func 1,2,3 that are passing in
-                    // a buffer to receive data via because NvU32 pointer is passed
-                    // below in osCallACPI_DSM call.
-                    dataSize = dataSize / 4;
-                }
             }
             else
             {
